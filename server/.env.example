PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/yawa
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo: Settings > SMTP & API. Use the SMTP login and SMTP KEY, not an API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# A verified sender in Brevo, NOT the SMTP login.
MAIL_FROM="YAWA <your-verified-sender@example.com>"

# Set NODE_ENV=production behind HTTPS. If behind one trusted reverse proxy:
# TRUST_PROXY=1
# Only for frontend/backend on different sites over HTTPS:
# COOKIE_SAME_SITE=none
